FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS builder

WORKDIR /src
COPY Widgetario.Web/Widgetario.Web.csproj .
RUN dotnet restore

COPY Widgetario.Web/ .
COPY v2/Index.cshtml ./Views/Home/
RUN dotnet publish -c Release -o /out Widgetario.Web.csproj

# app image
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine

ENV ASPNETCORE_HTTP_PORTS=80 \
    Widgetario__ProductsApi__Url="http://products-api/products" \
    Widgetario__StockApi__Url="http://stock-api:8080/stock" \
    Widgetario__Theme="light"

ENTRYPOINT ["dotnet", "/app/Widgetario.Web.dll"]

# create writeable paths
RUN mkdir -p /logs && \
    chown app:app /logs

WORKDIR /app
COPY --from=builder /out/ .